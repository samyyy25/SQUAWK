{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": { "x": 100, "y": 200 }
      }
    },
    {
      "id": "parse_1",
      "provider": "parse",
      "config": {},
      "input": [
        {
          "lane": "tags",
          "from": "webhook_1"
        }
      ],
      "ui": {
        "position": { "x": 300, "y": 200 }
      }
    },
    {
      "id": "preprocessor_1",
      "provider": "preprocessor",
      "config": {
        "profile": "default",
        "default": {
          "mode": "strlen",
          "splitter": "RecursiveCharacterTextSplitter",
          "strlen": 512
        }
      },
      "input": [
        {
          "lane": "text",
          "from": "parse_1"
        }
      ],
      "ui": {
        "position": { "x": 500, "y": 200 }
      }
    },
    {
      "id": "question_1",
      "provider": "question",
      "config": {
        "question": "Compute physical delivery variance, documentation defect flags, and updated reliability scores for vendor memory update."
      },
      "input": [
        {
          "lane": "documents",
          "from": "preprocessor_1"
        }
      ],
      "ui": {
        "position": { "x": 700, "y": 200 }
      }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "config": {
        "profile": "openai-5-2",
        "openai-5-2": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}",
          "model": "gpt-4-turbo"
        },
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "question_1"
        }
      ],
      "ui": {
        "position": { "x": 900, "y": 200 }
      }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "llm_openai_1"
        }
      ],
      "ui": {
        "position": { "x": 1100, "y": 200 }
      }
    }
  ],
  "project_id": "d4e5f6a7-b8c9-4d4e-bf5a-6b7c8d9e0f1a",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}
