# SQUAWK Environment Configuration

# RocketRide Orchestration
ROCKETRIDE_URI=https://api.rocketride.ai:443
ROCKETRIDE_APIKEY=demo_rocketride_key_squawk_2026
ROCKETRIDE_OPENAI_KEY=your_openai_api_key_here

# RocketRide Deployment Target
ROCKETRIDE_DEPLOY_URI=https://api.rocketride.ai:443
ROCKETRIDE_DEPLOY_APIKEY=demo_rocketride_deploy_key_squawk_2026

# AI / LLM Provider (Optional - deterministic fallback available)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Database Configuration (SQLite default for zero-setup local dev)
DATABASE_URL=sqlite:///./squawk.db

# Operations Mode
DEMO_MODE=true
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=5173

# Vakh Structured Intake & Collaboration Layer
VAKH_BASE_URL=https://vakh.com
VAKH_API_KEY=vakh_api_squawk_aog_recovery_2026
VAKH_WEBHOOK_SECRET=vakh_whsec_squawk_prod_99
VAKH_FORM_KEY=aog_defect_intake
VAKH_WORKSPACE_KEY=aog_recovery_workspace
